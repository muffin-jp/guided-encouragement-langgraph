# Server-only. Never expose this to any client.
# Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: LangSmith tracing (off by default; set to 1/true to enable).
# LANGSMITH_TRACING=1
# LANGSMITH_API_KEY=lsv2-...
# LANGSMITH_PROJECT=bloom-guided-encouragement

# Optional: put the human-in-the-loop moderation gate on the live distress path.
# Off by default — distress streams the static support message immediately.
# When enabled, distress cases pause at an interrupt and are continued via
# POST /api/encourage/{thread_id}/resume.
# MODERATION_ENABLED=1

# Optional eval tuning
# EVAL_CONCURRENCY=4
# EVAL_DRY=1
