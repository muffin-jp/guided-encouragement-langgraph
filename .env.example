# Server-only. Never expose this to any client.
# Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: LangSmith tracing (off by default; set to 1/true to enable).
# LANGSMITH_TRACING=1
# LANGSMITH_API_KEY=lsv2-...
# LANGSMITH_PROJECT=bloom-guided-encouragement

# Optional: the human-in-the-loop moderation gate on the distress path.
# On by default (non-blocking): support always streams to the player first, then
# the run pauses at an interrupt for out-of-band review via
# POST /api/encourage/{thread_id}/resume. Set to 0 to drop the gate entirely
# (distress becomes simply support -> END).
# MODERATION_ENABLED=0

# Optional: retrieval grounding on the encouragement path. On by default: the
# retrieve node fetches a few reviewed passages (filtered by feeling) and injects
# them into generation as grounding, not a script — critique/judge stays the gate.
# Set to 0 for an instant rollback to the exact pre-RAG graph (no retriever,
# index, or embedder loaded). Requires the `rag` extra + `make build-index` when on.
# RAG_ENABLED=0
# RAG_K=3          # passages injected as grounding
# RAG_MIN_K=2      # preferred floor when the corpus allows

# Optional: browser origins allowed to call the API. By default any
# localhost / 127.0.0.1 port is allowed (dev convenience). In production set an
# explicit comma-separated list and/or tighten the regex. curl / server-to-server
# callers are unaffected by CORS.
# CORS_ALLOW_ORIGINS=https://bloom.example
# CORS_ALLOW_ORIGIN_REGEX=https://.*\.bloom\.example

# Optional eval tuning
# EVAL_CONCURRENCY=4
# EVAL_DRY=1
